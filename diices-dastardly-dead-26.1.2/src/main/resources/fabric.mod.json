{
	"schemaVersion": 1,
	"id": "diices-dastardly-dead",
	"version": "${version}",
	"name": "Diices Dastardly Dead",
	"description": "A mod expanding on the types of undead in Minecraft.",
	"authors": [
		"TinyDiiceThief"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT-License",
	"icon": "assets/diices-dastardly-dead/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.tinydiicethief.diicesdastardlydead.DiicesDastardlyDead"
		],
		"client": [
			"net.tinydiicethief.diicesdastardlydead.client.DiicesDastardlyDeadClient"
		],
		"fabric-datagen": [
			"net.tinydiicethief.diicesdastardlydead.client.DiicesDastardlyDeadDataGenerator"
		]
	},
	"mixins": [
		"diices-dastardly-dead.mixins.json",
