{
	"schemaVersion": 1,
	"id": "rot-and-bone",

	"custom": {
		"cardinal-components": [
			"rotandbone:corruptioncomponent"
		]
	},

	"version": "${version}",
	"name": "Rot And Bone",
	"description": "A mod about expanding the undead and magic of Minecraft. Mostly cause I felt like it.",
	"authors": [
		"TinyDiiceThief"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT-License",
	"icon": "assets/rot-and-bone/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.tinydiicethief.rot_and_bone.RotAndBone"
		],
		"fabric-datagen": [
			"net.tinydiicethief.rot_and_bone.RotAndBoneDataGenerator"
		],
		"cardinal-components": [
			"net.tinydiicethief.rot_and_bone.component.ModComponentRegistry"
		]
	},
	"mixins": [
		"rot-and-bone.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}